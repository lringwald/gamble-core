# --- R / RStudio -------------------------------------------------------------
.Rproj.user
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --- macOS -------------------------------------------------------------------
.DS_Store

# --- model outputs: multi-GB and fully regenerable ---------------------------
# Everything the pipelines write (posterior batches, fitted objects, design dumps,
# node stores, logs, reports). Keep the directory itself so a fresh clone can run.
output/*
!output/.gitkeep

# --- local scratch and experiments -------------------------------------------
# Ad-hoc scripts, one-off probes, superseded runners. Never pushed.
_local/
scratch/
experiments/
.tmp*

# --- fitted results: posterior batches, artifacts, reports --------------------
# Same status as output/ -- multi-GB and fully regenerable from the design dump plus
# the run settings recorded in each run's lineage.txt. 626 MB and 230 files at the time
# this was added, which is not a git problem to have.
results/*
!results/.gitkeep

# --- stray run logs ----------------------------------------------------------
*.log

# Bulk inputs live with the data in cascadinggamble (data/input/), not here.
# gamble-core is the MODEL CODE; point GAMBLE_INPUT_DIR at wherever the data is.
input/

# Project-specific code lives in cascadinggamble (GitLab), not in the public model repo.
# See cascadinggamble-core/scripts/<PROJECT>/gamble_model/.
projects/
