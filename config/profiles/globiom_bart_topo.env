# GLOBIOM flat MNL with BART on the terrain surface + coordinates.
# Mirrors run/fit_flat_bart.sh. BART exists only on the FLAT path.
CLASSIFICATION=GLOBIOM_subclass
USE_BART=TRUE
BART_COLS=topo
ADD_COORDS=TRUE
COORD_TYPE=lonlat
BART_K_PREV=TRUE
NTREES_BART=25
NSAMPLE=6000
NBURN=2000
THIN=4
N_CHAINS=4
